@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IStringLocalizer<SharedResource> Localizer

@model WashZone.Pages.IndexModel
@{
    ViewData["Title"] = Localizer["HomeTitle"].Value;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<!-- ============ HERO ============ -->
<section class="hero">
    <video class="hero-video" autoplay muted loop playsinline poster="/images/hero.jpg">
        <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>

    <div class="container hero-content">
        @if (SignInManager.IsSignedIn(User))
        {
            <span class="hero-eyebrow">@Localizer["IndexWelcomeUser", User.Identity?.Name?.Split('@')[0] ?? "User"]</span>
            <h1 class="hero-title">@Localizer["HeroTitleLine1"]<br><span class="accent">@Localizer["HeroTitleLine2"]</span></h1>
            <p class="hero-text">@Localizer["IndexHeroText"]</p>
            <div class="hero-actions">
                <form method="post">
                    <button class="btn btn-accent btn-lg" type="submit" asp-page-handler="BookPage">@Localizer["BookWash"]</button>
                </form>
            </div>
        }
        else
        {
            <h1 class="hero-title">@Localizer["HeroTitleLine1"]<br><span class="accent">@Localizer["HeroTitleLine2"]</span></h1>
            <p class="hero-text">@Localizer["IndexHeroText"]</p>
            <div class="hero-actions">
                <a href="~/Identity/Account/Login" class="btn btn-accent btn-lg">@Localizer["BookWash"]</a>
            </div>
        }
    </div>
</section>

<!-- ============ MARQUEE ============ -->
<div class="marquee" aria-hidden="true">
    <div class="marquee-track">
        @for (int half = 0; half < 2; half++)
        {
            <div class="marquee-group">
                @for (int i = 0; i < 4; i++)
                {
                    <span>@Localizer["MarqueeText"]</span><span class="dot">•</span>
                    <span>@Localizer["StatsHours"] 08–20</span><span class="dot">•</span>
                    <span>@Model.Stations.Count @Localizer["StatsStations"]</span><span class="dot">•</span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ HOW IT WORKS ============ -->
<section class="container py-6">
    <div class="text-center mb-5">
        <h2 class="section-head">@Localizer["HowItWorksTitle"]</h2>
    </div>
    <div class="steps">
        <div class="step">
            <div class="step__num">01</div>
            <h3 class="step__title">@Localizer["Step1Title"]</h3>
            <p class="step__text">@Localizer["Step1Text"]</p>
        </div>
        <div class="step">
            <div class="step__num">02</div>
            <h3 class="step__title">@Localizer["Step2Title"]</h3>
            <p class="step__text">@Localizer["Step2Text"]</p>
        </div>
        <div class="step">
            <div class="step__num">03</div>
            <h3 class="step__title">@Localizer["Step3Title"]</h3>
            <p class="step__text">@Localizer["Step3Text"]</p>
        </div>
    </div>
</section>

<!-- ============ STATIONS ============ -->
<section class="container py-6">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h2 class="section-head">@Localizer["IndexStationsHeading"]</h2>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0">@Localizer["IndexFilterLabel"]</label>
            <div class="dropdown">
                <button class="btn btn-outline dropdown-toggle" type="button" data-bs-toggle="dropdown" id="dropdownMenuButton">
                    @Localizer["IndexAllPackages"]
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item package-option" data-value="">@Localizer["IndexAllPackages"]</a></li>
                    @foreach (var package in Model.Packages)
                    {
                        <li><a class="dropdown-item package-option" data-value="@package.Id">@package.Name</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <partial name="_StationCards" model="Model.Stations" />
</section>

<!-- ============ VIDEO SHOWCASE ============ -->
<section class="showcase">
    <div class="container">
        <div class="showcase-frame">
            <video autoplay muted loop playsinline poster="/images/hero.jpg">
                <source src="/videos/showcase.mp4" type="video/mp4" />
            </video>
            <div class="showcase-overlay"></div>
            <div class="showcase-content">
                <h2 class="showcase-title">@Localizer["VideoBandTitle"]</h2>
                <p class="showcase-text">@Localizer["VideoBandText"]</p>
                <p class="showcase-text">@Localizer["VideoBandExtra"]</p>
            </div>
            <span class="showcase-badge">REC</span>
            <span class="showcase-timecode">00:14</span>
            <span class="corner corner-tl"></span>
            <span class="corner corner-tr"></span>
            <span class="corner corner-bl"></span>
            <span class="corner corner-br"></span>
        </div>
    </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="container py-6 d-none d-lg-block">
    <div class="mb-4">
        <h2 class="section-head">@Localizer["OurServices"]</h2>
        <p class="text-muted">@Localizer["OurServicesSub"]</p>
    </div>
    <div class="services-grid">
        @foreach (var feature in Model.Features)
        {
            <div class="service">
                <img class="service__icon" src="~/images/@(feature.Name.ToLower().Replace(" ", "-")).png" alt="@feature.Name" />
                <p class="service__name">@feature.Name</p>
            </div>
        }
    </div>
</section>

<!-- ============ MAP ============ -->
<section class="container py-6">
    <div class="mb-4">
        <div class="section-sub">Malmö</div>
        <h2 class="section-head">@Localizer["IndexLocationsHeading"]</h2>
    </div>
    <div class="map-frame">
        <div id="map"></div>
    </div>
</section>

<!-- ============ CTA ============ -->
<section class="container py-6">
    <div class="cta-band text-center">
        <h2 class="cta-title marker">@Localizer["IndexCtaTitle"]</h2>
        <p class="lead mb-4 mx-auto" style="max-width:34rem">@Localizer["IndexCtaText"]</p>
        @if (SignInManager.IsSignedIn(User))
        {
            <a asp-page="/BookPage" class="btn btn-lg">@Localizer["BookWash"]</a>
        }
        else
        {
            <a href="/Identity/Account/Login" class="btn btn-lg">@Localizer["BookWash"]</a>
        }
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Package filter dropdown (AJAX, no page reload)
        document.querySelectorAll('.package-option').forEach(item => {
            item.addEventListener('click', function () {
                const packageId = this.getAttribute('data-value');
                document.getElementById('dropdownMenuButton').textContent = this.textContent;
                fetch(`/Index?handler=Stations&packageId=${packageId}`)
                    .then(r => r.text())
                    .then(html => {
                        document.getElementById('stationsGrid').outerHTML = html;
                    });
            });
        });

        // --- Leaflet map ---
        const stations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stations.Select(s => new { name = s.Name, address = s.Address, id = s.Id })));

        const stationCoordinates = {
            "Centrum": { lat: 55.6072, lng: 13.0017 },
            "Västra Hamnen": { lat: 55.6135, lng: 12.9770 },
            "Rosengård": { lat: 55.5883, lng: 13.0320 },
            "Limhamn": { lat: 55.5800, lng: 12.9340 },
            "Hyllie": { lat: 55.5470, lng: 12.9820 },
            "Möllevången": { lat: 55.5920, lng: 13.0070 },
            "Sorgenfri": { lat: 55.6300, lng: 13.0150 },
            "Kirseberg": { lat: 55.5850, lng: 13.0500 }
        };

        const map = L.map('map', { scrollWheelZoom: false, dragging: false, touchZoom: false, doubleClickZoom: false, boxZoom: false, keyboard: false, zoomControl: false }).setView([55.6050, 13.0038], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const icon = L.icon({
            iconUrl: '/images/car-wash.png',
            iconSize: [40, 40],
            iconAnchor: [20, 20],
        });

        const bounds = L.latLngBounds([]);
        stations.forEach(station => {
            const coords = stationCoordinates[station.name];
            if (!coords) return;
            L.marker([coords.lat, coords.lng], { icon })
                .addTo(map)
                .bindPopup(`<strong>${station.name}</strong><br>${station.address}<br><a href="/DetailsCarwash/${station.id}">View details →</a>`);
            bounds.extend([coords.lat, coords.lng]);
        });

        if (bounds.isValid()) {
            map.fitBounds(bounds, { padding: [40, 40], maxZoom: 12 });
        }
    </script>
}
