@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.AdminDashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";

    var sortSelect = new SelectModel
    {
        Name = "sortOrder",
        Label = Localizer["SortByDate"].Value,
        OnChange = "this.form.submit()",
        Class = "mb-0",
        Options = new List<SelectOptionModel>
        {
            new() { Value = "asc", Text = Localizer["OldestFirst"].Value, Selected = Model.SortOrder == "asc" },
            new() { Value = "desc", Text = Localizer["NewestFirst"].Value, Selected = Model.SortOrder == "desc" }
        }
    };

    var stationSelect = new SelectModel
    {
        Name = "stationId",
        Label = Localizer["FilterByStation"].Value,
        OnChange = "this.form.submit()",
        Class = "mb-0",
        Options = new List<SelectOptionModel> { new() { Value = "", Text = Localizer["AllStations"].Value } }
    };
    stationSelect.Options.AddRange(Model.Stations.Select(s => new SelectOptionModel
    {
        Value = s.Id.ToString(),
        Text = s.Name,
        Selected = Model.SelectedStationId == s.Id
    }));

    var packageSelect = new SelectModel
    {
        Name = "packageId",
        Label = Localizer["FilterByPackage"].Value,
        OnChange = "this.form.submit()",
        Class = "mb-0",
        Options = new List<SelectOptionModel> { new() { Value = "", Text = Localizer["AllPackages"].Value } }
    };
    packageSelect.Options.AddRange(Model.Packages.Select(p => new SelectOptionModel
    {
        Value = p.Id.ToString(),
        Text = p.Name,
        Selected = Model.SelectedPackageId == p.Id
    }));

    var regField = new FieldModel
    {
        Name = "regNumber",
        Label = Localizer["FilterByRegNumber"].Value,
        Value = Model.RegNumberFilter,
        Placeholder = Localizer["EnterRegNumberPlaceholder"].Value,
        OnChange = "this.form.submit()",
        Class = "mb-0"
    };

    var phoneField = new FieldModel
    {
        Name = "phoneNumber",
        Label = Localizer["FilterByPhone"].Value,
        Value = Model.PhoneNumberFilter,
        Placeholder = Localizer["EnterPhonePlaceholder"].Value,
        OnChange = "this.form.submit()",
        Class = "mb-0"
    };

    var stationsBtn = new ButtonModel { Text = Localizer["ManageStations"].Value, Page = "/AdminStations", Variant = "dark" };
    var packagesBtn = new ButtonModel { Text = Localizer["ManagePackages"].Value, Page = "/AdminPackages", Variant = "dark" };
    var resetBtn = new ButtonModel { Text = Localizer["ResetFilters"].Value, Href = "/AdminDashboard", Variant = "outline", Class = "btn-field" };
}

<section class="container py-6">
    <div class="section-sub">WashZone</div>
    <h1 class="section-head mb-2">@Localizer["AdminTitle"]</h1>
    <p class="text-muted mb-4">@Localizer["AdminSubtitle"]</p>

    <div class="d-flex gap-2 mb-4">
        <partial name="_Btn" model="stationsBtn" />
        <partial name="_Btn" model="packagesBtn" />
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-6 col-md-4 col-xl">
            <partial name="_Select" model="sortSelect" />
        </div>
        <div class="col-6 col-md-4 col-xl">
            <partial name="_Select" model="stationSelect" />
        </div>
        <div class="col-6 col-md-4 col-xl">
            <partial name="_Select" model="packageSelect" />
        </div>
        <div class="col-6 col-md-4 col-xl">
            <partial name="_Field" model="regField" />
        </div>
        <div class="col-6 col-md-4 col-xl">
            <partial name="_Field" model="phoneField" />
        </div>
        <div class="col-auto">
            <partial name="_Btn" model="resetBtn" />
        </div>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["ColDate"]</th>
                <th>@Localizer["ColTime"]</th>
                <th>@Localizer["ColUser"]</th>
                <th>@Localizer["ColPhone"]</th>
                <th>@Localizer["ColStation"]</th>
                <th>@Localizer["ColPackage"]</th>
                <th>@Localizer["ColRegNumber"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.Date.ToString("yyyy-MM-dd")</td>
                    <td>@booking.Date.ToString("HH:mm")</td>
                    <td>@booking.User?.UserName</td>
                    <td>@booking.User?.PhoneNumber</td>
                    <td>@booking.Station?.Name</td>
                    <td>@booking.Package?.Name</td>
                    <td>@booking.RegistrationNumber</td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-page="/EditBooking" asp-route-id="@booking.Id" class="btn btn-outline btn-sm">@Localizer["Edit"]</a>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
