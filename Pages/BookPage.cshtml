@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.BookPageModel
@{
    ViewData["Title"] = "Book a Service";
}
<h2 class="text-center">@Localizer["BookTitle"]</h2>
<form method="post" class="booking-form">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <label for="Station">@Localizer["BookStation"]</label>
    <select id="Station" name="SelectedStationId" asp-for="SelectedStationId" required>
        @if (Model.Stations != null && Model.Stations.Any())
        {
            @foreach (var Station in Model.Stations)
            {
                <option value="@Station.Id">@Station.Name</option>
            }
        }
        else
        {
            <option disabled>@Localizer["BookNoStations"]</option>
        }

    </select>
    <span asp-validation-for="SelectedStationId" class="text-danger"></span>

    <label for="month">@Localizer["BookMonth"]</label>
    <select id="month" name="SelectedMonth" asp-for="SelectedMonth" required>
        @for (int month = 1; month <= 12; month++)
        {
            <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
        }
    </select>
    <span asp-validation-for="SelectedMonth" class="text-danger"></span>

    <label for="day">@Localizer["BookDay"]</label>
    <select id="day" name="SelectedDay" asp-for="SelectedDay" required>
        @for (int i = 1; i <= 31; i++)
        {
            <option value="@i">@i</option>
        }
    </select>
    <span asp-validation-for="SelectedDay" class="text-danger"></span>

    <label for="time">@Localizer["BookTime"]</label>
    <select id="time" name="SelectedTime" asp-for="SelectedTime" required>
        @for (int hour = 8; hour < 22; hour++)
        {
            @for (int minutes = 0; minutes < 60; minutes += 15)
            {
                var time = $"{hour:D2}:{minutes:D2}";
                <option value="@time">@time</option>
            }
        }
        <option value="22:00">22:00</option>
    </select>
    <span asp-validation-for="SelectedTime" class="text-danger"></span>

    <label for="package">@Localizer["BookPackage"]</label>

    <select id="package" name="SelectedPackageId" asp-for="SelectedPackageId" required>
        <option value="">@Localizer["BookSelectStationFirst"]</option>
    </select>
    <span asp-validation-for="SelectedPackageId" class="text-danger"></span>

    <label for="regNumber">@Localizer["BookRegNumber"]</label>
    <input class="form-control mb-3" type="text" id="regNumber" name="RegistrationNumber"
		   pattern="[A-Z]{3}[0-9]{3}" asp-for="RegistrationNumber" placeholder="@Localizer["BookRegPlaceholder"]" required />
    <span asp-validation-for="RegistrationNumber" class="text-danger"></span>

    <div id="regError" class="custom-error">@Localizer["BookRegError"]</div>
    <label>
        <input type="checkbox" id="customPlateCheckbox"> @Localizer["BookCustomPlate"]
    </label>

    <input type="submit" class="btn btn-dark mt-4" value="@Localizer["BookSubmit"]">
</form>

<style>
    .booking-form {
        max-width: 600px;
        margin: auto;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        background-color: #f9f9f9;
    }

        .booking-form label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .booking-form select,
        .booking-form input[type="submit"] {
            width: 100%;
            padding: 8px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        #BookingHead{
            			text-align: center;
        }

    .custom-error {
        display: none;
        color: #C41E3A;
        font-size: 14px;
        margin-top: 5px;
        margin-bottom: 5px;
        background: #ffdddd;
        padding: 5px;
        border: 1px solid #C41E3A;
        border-radius: 5px;
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const regInput = document.getElementById("regNumber");
        const errorBox = document.getElementById("regError");
        const customPlateCheckbox = document.getElementById("customPlateCheckbox");

        regInput.addEventListener("input", function () {
            const pattern = /^[A-Z]{3}[0-9]{3}$/;
            if (!customPlateCheckbox.checked && !pattern.test(regInput.value)) {
                errorBox.style.display = "block";
            } else {
                errorBox.style.display = "none";
            }
        });

        customPlateCheckbox.addEventListener("change", function () {
            if (customPlateCheckbox.checked) {
                regInput.removeAttribute("pattern");
                regInput.removeAttribute("title");
                regInput.classList.remove("invalid");
                errorBox.style.display = "none";
            } else {
                regInput.setAttribute("pattern", "[A-Z]{3}[0-9]{3}");
                regInput.setAttribute("title", "Enter a valid car registration number (ABC123)");
            }
        });
    });
</script><!--script for validation of reg number-->
<script>
	
    document.addEventListener("DOMContentLoaded", function () {
        const stationSelect = document.getElementById("Station");
        const packageSelect = document.getElementById("package");

        stationSelect.addEventListener("change", function () {
            const stationId = this.value;

            if (!stationId) {
                packageSelect.innerHTML = '<option value="">@Localizer["BookSelectStationFirst"]</option>';
                return;
            }

            fetch(`/BookPage?handler=Packages&stationId=${stationId}`)
                .then(response => response.json())
                .then(data => {
                    packageSelect.innerHTML = '';
                    if (data.length > 0) {
                        data.forEach(pkg => {
                            const option = document.createElement("option");
                            option.value = pkg.id;
                            option.textContent = pkg.name;
                            packageSelect.appendChild(option);
                        });
                    } else {
                        packageSelect.innerHTML = '<option value="">@Localizer["BookNoPackages"]</option>';
                    }
                })
                .catch(error => console.error("Error fetching packages:", error));
        });
    });
</script><!--script for fetching packages based on selected station-->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
