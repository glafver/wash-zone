@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.BookPageModel
@{
    ViewData["Title"] = "Book a Service";
}
<h2 class="text-center">@Localizer["BookTitle"]</h2>

<form method="post" class="booking-form" id="bookingForm">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <label for="Station">@Localizer["BookStation"]</label>
    <select id="Station" name="SelectedStationId" asp-for="SelectedStationId" required>
        <option value="">@Localizer["BookSelectStationFirst"]</option>
        @if (Model.Stations != null)
        {
            @foreach (var station in Model.Stations)
            {
                <option value="@station.Id">@station.Name</option>
            }
        }
    </select>
    <span asp-validation-for="SelectedStationId" class="text-danger"></span>

    <label for="package">@Localizer["BookPackage"]</label>
    <select id="package" name="SelectedPackageId" asp-for="SelectedPackageId" required>
        <option value="">@Localizer["BookSelectStationFirst"]</option>
    </select>
    <span asp-validation-for="SelectedPackageId" class="text-danger"></span>

    <input type="hidden" name="SelectedSlot" id="selectedSlot" asp-for="SelectedSlot" />

    <label>@Localizer["BookChooseSlot"]</label>
    <div id="calendar" class="calendar-container mb-3">
        <p class="text-muted">@Localizer["CalendarPrompt"]</p>
    </div>
    <span asp-validation-for="SelectedSlot" class="text-danger"></span>

    <label for="regNumber">@Localizer["BookRegNumber"]</label>
    <input class="form-control mb-3" type="text" id="regNumber" name="RegistrationNumber"
           asp-for="RegistrationNumber" placeholder="@Localizer["BookRegPlaceholder"]" required />
    <span asp-validation-for="RegistrationNumber" class="text-danger"></span>

    <input type="submit" class="btn btn-dark mt-4" value="@Localizer["BookSubmit"]">
</form>

<style>
    .booking-form { max-width: 900px; margin: auto; padding: 20px; border: 1px solid #ccc; border-radius: 10px; background-color: #f9f9f9; }
    .booking-form label { display: block; margin-bottom: 8px; font-weight: bold; }
    .booking-form select, .booking-form input[type="text"] { width: 100%; padding: 8px; margin-bottom: 20px; border: 1px solid #ccc; border-radius: 5px; }
    .booking-form input[type="submit"] { width: 100%; padding: 10px; }

    .calendar-container { overflow-x: auto; }
    .calendar-grid { display: grid; grid-template-columns: 70px repeat(7, 1fr); gap: 2px; }
    .cal-header { font-weight: bold; text-align: center; background: #212529; color: #fff; padding: 6px 2px; font-size: 0.85rem; }
    .cal-time { text-align: right; padding-right: 8px; font-size: 0.8rem; color: #555; align-self: center; }
    .cal-cell { height: 30px; border-radius: 4px; cursor: default; background: #eee; }
    .cal-cell.available { background: #d4edda; cursor: pointer; }
    .cal-cell.available:hover { background: #a8d8b0; }
    .cal-cell.booked { background: #f8d7da; }
    .cal-cell.selected { background: #0d6efd; outline: 2px solid #084298; }
</style>

<script>
    let selectedSlot = null;

    function parseSlot(s) {
        // s = "yyyy-MM-ddTHH:mm:ss"
        const parts = s.split('T');
        const d = parts[0].split('-').map(Number);
        const t = parts[1].split(':').map(Number);
        return new Date(d[0], d[1] - 1, d[2], t[0], t[1], t[2]);
    }

    function toHHMM(minutes) {
        const h = String(Math.floor(minutes / 60)).padStart(2, '0');
        const m = String(minutes % 60).padStart(2, '0');
        return h + ':' + m;
    }

    function toMinutes(hhmm) {
        const p = hhmm.split(':').map(Number);
        return p[0] * 60 + p[1];
    }

    function renderCalendar(data) {
        const calendar = document.getElementById('calendar');
        const step = 30;
        const opening = toMinutes(data.openingTime);
        const closing = toMinutes(data.closingTime);
        const duration = data.durationMinutes;
        const now = new Date();

        const booked = data.booked.map(b => ({ start: parseSlot(b.start), duration: b.duration }));

        function isBooked(start) {
            const end = new Date(start.getTime() + duration * 60000);
            return booked.some(b => {
                const bEnd = new Date(b.start.getTime() + b.duration * 60000);
                return start < bEnd && b.start < end;
            });
        }

        let html = '<div class="calendar-grid">';
        html += '<div class="cal-header"></div>';
        for (const day of data.days) {
            html += `<div class="cal-header">${day.weekday}<br>${day.day} ${day.month}</div>`;
        }

        for (let t = opening; t + duration <= closing; t += step) {
            const timeLabel = toHHMM(t);
            html += `<div class="cal-time">${timeLabel}</div>`;
            for (const day of data.days) {
                const slotStr = `${day.date}T${timeLabel}:00`;
                const start = parseSlot(slotStr);
                const past = start < now;
                const bookedCell = isBooked(start);
                const isSelected = selectedSlot === slotStr;
                let cls;
                if (bookedCell || past) cls = 'cal-cell booked';
                else if (isSelected) cls = 'cal-cell selected';
                else cls = 'cal-cell available';
                html += `<div class="${cls}" data-slot="${slotStr}"></div>`;
            }
        }
        html += '</div>';
        calendar.innerHTML = html;

        calendar.querySelectorAll('.cal-cell.available').forEach(cell => {
            cell.addEventListener('click', () => {
                selectedSlot = cell.getAttribute('data-slot');
                document.getElementById('selectedSlot').value = selectedSlot;
                calendar.querySelectorAll('.cal-cell').forEach(c => c.classList.remove('selected'));
                cell.classList.add('selected');
            });
        });
    }

    function loadPackages() {
        const stationId = document.getElementById('Station').value;
        const packageSelect = document.getElementById('package');
        packageSelect.innerHTML = '';
        if (!stationId) {
            packageSelect.innerHTML = '<option value="">@Localizer["BookSelectStationFirst"]</option>';
            renderEmpty();
            return;
        }
        fetch(`/BookPage?handler=Packages&stationId=${stationId}`)
            .then(r => r.json())
            .then(data => {
                if (data.length > 0) {
                    data.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p.id;
                        opt.textContent = `${p.name} (${p.durationMinutes} min, ${p.price} kr)`;
                        packageSelect.appendChild(opt);
                    });
                } else {
                    packageSelect.innerHTML = '<option value="">@Localizer["BookNoPackages"]</option>';
                }
                renderEmpty();
            })
            .catch(() => {});
    }

    function renderEmpty() {
        document.getElementById('calendar').innerHTML = '<p class="text-muted">@Localizer["CalendarPrompt"]</p>';
        document.getElementById('selectedSlot').value = '';
        selectedSlot = null;
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('Station').addEventListener('change', loadPackages);
        document.getElementById('package').addEventListener('change', fetchCalendar);
    });

    function fetchCalendar() {
        const stationId = document.getElementById('Station').value;
        const packageId = document.getElementById('package').value;
        selectedSlot = null;
        document.getElementById('selectedSlot').value = '';
        if (!stationId || !packageId) { renderEmpty(); return; }
        fetch(`/BookPage?handler=Calendar&stationId=${stationId}&packageId=${packageId}`)
            .then(r => r.json())
            .then(renderCalendar)
            .catch(() => {});
    }
</script>
