@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.PackageEditModel
@{
    ViewData["Title"] = Localizer["EditPackage"].Value;

    var nameField = new FieldModel { Name = "Package.Name", Label = Localizer["PackageName"].Value, Value = Model.Package.Name, Required = true };
    var priceField = new FieldModel { Name = "Package.Price", Label = Localizer["PackagePrice"].Value, Value = Model.Package.Price.ToString(), Type = "number", Required = true };
    var durationField = new FieldModel { Name = "Package.DurationMinutes", Label = Localizer["PackageDuration"].Value, Value = Model.Package.DurationMinutes.ToString(), Type = "number", Required = true };
    var cancelBtn = new ButtonModel { Text = Localizer["EditCancel"].Value, Page = "/AdminPackages", Variant = "outline" };
}

<section class="container py-6">
    <div class="section-sub">WashZone</div>
    <h1 class="section-head mb-4">@Localizer["EditPackage"]</h1>

    <form method="post" class="mb-4">
        <input type="hidden" asp-for="Package.Id" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <partial name="_Field" model="nameField" />
        <partial name="_Field" model="priceField" />
        <partial name="_Field" model="durationField" />

        <div class="field">
            <label class="form-label">@Localizer["PackageFeatures"]</label>
            @foreach (var f in Model.AllFeatures)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedFeatureIds" value="@f.Id" id="feat_@f.Id"
                           @(Model.SelectedFeatureIds.Contains(f.Id) ? "checked" : "") />
                    <label class="form-check-label" for="feat_@f.Id">@f.Name</label>
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark">@Localizer["Save"]</button>
            <partial name="_Btn" model="cancelBtn" />
        </div>
    </form>
</section>
