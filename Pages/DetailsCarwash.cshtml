@page "{id:int}"
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.DetailsCarwashModel


@{
    ViewData["Title"] = "Station Details";
}

<div class="container px-3 mb-4">
    <a asp-page="/Index" class="btn btn-outline-dark mb-3">
        ← @Localizer["DetailsBack"]
    </a>

    <div class="row align-items-center rounded bg-dark my-5">
        <div class="col-md-6 ps-5 text-light">
            <h2>@Model.Station?.Name</h2>
            <p class="mb-3">@Model.Station?.Address</p>
            <p>+46761234578</p>
        </div>

        <div class="col-md-6 text-md-end text-center px-0">
            <iframe width="100%" height="200" style="border:0; border-radius:0 4px 4px 0; margin-bottom: -6px"
                    loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"
                    src="https://www.google.com/maps?q=@Uri.EscapeDataString(Model.Station?.Address ?? "")&output=embed">
            </iframe>
        </div>
    </div>
</div>

<!-- Show the right button based on login status -->
<div class="container text-center my-5">
    @if (SignInManager.IsSignedIn(User))
    {
        <h3>@Localizer["DetailsReadyTitle"]</h3>
        <a asp-page="/BookPage" class="btn btn-dark mt-3">@Localizer["BookWash"]</a>
    }
    else
    {
        <h3>@Localizer["DetailsLoginTitle"]</h3>
        <a href="/Identity/Account/Login" class="btn btn-dark mt-3">@Localizer["LoginToBook"]</a>
    }
</div>

<div class="container">
    <!-- Shows packages available at the station -->
    <h3 class="mb-4">@Localizer["DetailsAvailablePackages"]</h3>
    @{
        var sortedPackages = Model.AvailablePackages
        .OrderByDescending(p => p.PackageFeatures.Count)
        .ToList();
    }

    <div class="row g-4">
        @foreach (var package in sortedPackages)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_PackageCard" model="package" />
            </div>
        }
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

