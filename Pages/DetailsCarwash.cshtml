@page "{id:int}"
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.DetailsCarwashModel

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

@{
    ViewData["Title"] = "Station Details";
}

<div class="container px-3 mb-4">
    <div class="row align-items-center bg-dark my-5">
        <div class="col-md-6 ps-5 py-4 text-light">
            <h2 class="marker" style="font-size:clamp(2.5rem,6vw,4rem)">@Model.Station?.Name</h2>
            <p class="mb-3">@Model.Station?.Address</p>
            <p>+46761234578</p>
        </div>

        <div class="col-md-6">
            <div id="map" style="height:280px;"></div>
        </div>
    </div>
</div>

<!-- Show the right button based on login status -->
<div class="container text-center my-5">
    @if (SignInManager.IsSignedIn(User))
    {
        <h3>@Localizer["DetailsReadyTitle"]</h3>
        <a asp-page="/BookPage" class="btn btn-dark mt-3">@Localizer["BookWash"]</a>
    }
    else
    {
        <h3>@Localizer["DetailsLoginTitle"]</h3>
        <a href="/Identity/Account/Login" class="btn btn-dark mt-3">@Localizer["LoginToBook"]</a>
    }
</div>

<div class="container pb-6">
    <!-- Shows packages available at the station -->
    <h3 class="mb-4">@Localizer["DetailsAvailablePackages"]</h3>
    @{
        var sortedPackages = Model.AvailablePackages
        .OrderByDescending(p => p.PackageFeatures.Count)
        .ToList();
    }

    <div class="row g-4">
        @foreach (var package in sortedPackages)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_PackageCard" model="package" />
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const stationName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Station?.Name ?? ""));
        const stationAddress = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Station?.Address ?? ""));

        const stationCoordinates = {
            "Centrum": { lat: 55.6075, lng: 13.0015 },
            "Västra Hamnen": { lat: 55.6176, lng: 12.9338 },
            "Rosengård": { lat: 55.5888, lng: 13.0235 },
            "Limhamn": { lat: 55.5708, lng: 12.9443 },
            "Hyllie": { lat: 55.5432, lng: 12.9912 },
            "Möllevången": { lat: 55.6130, lng: 12.9670 },
            "Sorgenfri": { lat: 55.6305, lng: 13.0075 },
            "Kirseberg": { lat: 55.5820, lng: 12.9895 }
        };

        const coords = stationCoordinates[stationName] || { lat: 55.6050, lng: 12.9850 };

        const map = L.map('map').setView([coords.lat, coords.lng], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
        L.marker([coords.lat, coords.lng]).addTo(map)
            .bindPopup(`<strong>${stationName}</strong><br>${stationAddress}`);

        // Fix a potential right-edge gap when the grid layout settles
        setTimeout(() => map.invalidateSize(), 200);
    </script>
}
