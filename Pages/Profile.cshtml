@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.ProfileModel
@{
    ViewData["Title"] = Localizer["Profile"].Value;
}

<section class="container py-6">
    <div class="section-sub">WashZone</div>
    <h1 class="section-head mb-4">@Localizer["Profile"]</h1>

    <div class="row g-5">
        <!-- Account details -->
        <div class="col-lg-6">
            <h3 class="mb-3">@Localizer["EmailField"]</h3>
            <p class="text-muted">@Model.Email</p>

            @if (!User.IsInRole("Admin") && !User.IsInRole("StationAdmin"))
            {
                <h3 class="mb-3 mt-4">@Localizer["PhoneNumberField"]</h3>
                <form method="post" asp-page-handler="UpdatePhone" class="d-flex gap-2">
                    <input asp-for="NewPhoneNumber" class="form-control" placeholder="+46*********" />
                    <button type="submit" class="btn btn-dark">@Localizer["Save"]</button>
                </form>

                <h3 class="mb-3 mt-4">@Localizer["YourCars"]</h3>
                @if (Model.Vehicles.Any())
                {
                    <ul class="footer-list mb-3">
                        @foreach (var car in Model.Vehicles)
                        {
                            <li class="d-flex align-items-center justify-content-between py-1" style="border-bottom:1px solid var(--ink)">
                                <span class="fw-bold">@car.RegistrationNumber</span>
                                <form method="post" asp-page-handler="RemoveVehicle" asp-route-id="@car.Id" class="d-inline m-0">
                                    <button type="submit" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">@Localizer["NoCars"]</p>
                }

                <form method="post" asp-page-handler="AddVehicle">
                    <input asp-for="NewRegistrationNumber" class="form-control" placeholder="@Localizer["BookRegPlaceholder"]" />
                    <button type="submit" class="btn btn-dark mt-2">@Localizer["AddCar"]</button>
                </form>
            }
        </div>

        <!-- Change password -->
        <div class="col-lg-6">
            <h3 class="mb-3">@Localizer["ChangePassword"]</h3>
            <form method="post" asp-page-handler="ChangePassword">
                <div class="form-floating mb-3">
                    <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="CurrentPassword" class="form-label">@Localizer["CurrentPassword"]</label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="NewPassword" class="form-control pe-5" type="password" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="NewPassword" class="form-label">@Localizer["NewPassword"]</label>
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="ConfirmPassword" class="form-control pe-5" type="password" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="ConfirmPassword" class="form-label">@Localizer["ConfirmPasswordField"]</label>
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <button type="submit" class="btn btn-dark">@Localizer["ChangePassword"]</button>
            </form>
        </div>
    </div>

    @if (Model.CanDeleteAccount)
    {
        <div class="mt-5 pt-4" style="border-top: var(--border)">
            <form method="post" asp-page-handler="DeleteAccount">
                <button type="submit" class="btn btn-danger" onclick="return confirm('@Localizer["DeleteAccountConfirm"].Value')">@Localizer["DeleteAccount"]</button>
            </form>
        </div>
    }
</section>
