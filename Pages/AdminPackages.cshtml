@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.AdminPackagesModel
@{
    ViewData["Title"] = "Packages";

    var addBtn = new ButtonModel { Text = Localizer["AddPackage"].Value, Page = "/PackageEdit", Variant = "dark" };
    var backBtn = new ButtonModel { Text = Localizer["Back"].Value, Page = "/AdminDashboard", Variant = "outline" };
}

<section class="container py-6">
    <div class="section-sub">WashZone</div>
    <h1 class="section-head mb-4">@Localizer["ManagePackages"]</h1>

    <div class="d-flex gap-2 mb-4">
        <partial name="_Btn" model="addBtn" />
        <partial name="_Btn" model="backBtn" />
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>@Localizer["PackageName"]</th>
                <th>@Localizer["PackagePrice"]</th>
                <th>@Localizer["PackageDuration"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var package in Model.Packages)
            {
                <tr>
                    <td>@package.Name</td>
                    <td>@package.Price kr</td>
                    <td>@package.DurationMinutes min</td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-page="/PackageEdit" asp-route-id="@package.Id" class="btn btn-outline btn-sm">@Localizer["Edit"]</a>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@package.Id" />
                                <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
