<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WashZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="https://img.icons8.com/?size=100&id=2nqOdSG5BPti&format=png&color=000000">
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <span class="brand-mark">W</span>
                    <span class="brand">WashZone</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="mainNav">
                    <div class="nav-links d-flex flex-column flex-lg-row align-items-lg-center gap-1 gap-lg-0 mt-2 mt-lg-0">
                        <partial name="_LoginPartial" />
                        @{
                            var currentLang = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "en";
                            var targetLang = currentLang == "sv" ? "en" : "sv";
                        }
                        <form method="post" action="/set-language" class="ms-lg-3 mt-2 mt-lg-0">
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                            <input type="hidden" name="culture" value="@targetLang" />
                            <button type="submit" class="lang-btn" title="@(targetLang == "sv" ? "Svenska" : "English")">@currentLang.ToUpperInvariant()</button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer py-4">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="brand" style="font-size:1.1rem">WashZone</span>
            <span class="font-mono" style="font-family:var(--font-mono); font-size:0.8rem">&copy; @DateTime.Now.Year — clean. fast. flawless.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
