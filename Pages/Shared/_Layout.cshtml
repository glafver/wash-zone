@inject IStringLocalizer<SharedResource> Localizer
@{
    var currentLang = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "en";
    var targetLang = currentLang == "sv" ? "en" : "sv";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WashZone | @ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <span class="brand-mark">WZ</span>
                    <span class="brand">WashZone</span>
                </a>

                <div class="d-lg-none d-flex align-items-center gap-2">
                    <form method="post" action="/set-language">
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        <input type="hidden" name="culture" value="@targetLang" />
                        <button type="submit" class="lang-btn" title="@(targetLang == "sv" ? "Svenska" : "English")">@currentLang.ToUpperInvariant()</button>
                    </form>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 nav-links">
                        <li class="nav-item"><a class="nav-link" asp-page="/Stations">@Localizer["NavStations"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Packages">@Localizer["NavPackages"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/About">@Localizer["NavAbout"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contacts">@Localizer["NavContacts"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/FAQ">@Localizer["NavFAQ"]</a></li>
                    </ul>

                    <div class="nav-links d-flex align-items-center justify-content-end gap-2 mt-2 mt-lg-0">
                        <partial name="_LoginPartial" />
                        <div class="d-none d-lg-block">
                            <form method="post" action="/set-language">
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <input type="hidden" name="culture" value="@targetLang" />
                                <button type="submit" class="lang-btn" title="@(targetLang == "sv" ? "Svenska" : "English")">@currentLang.ToUpperInvariant()</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-5">
                    <span class="brand" style="font-size:2.4rem; color:var(--paper)">WashZone</span>
                    <p class="mt-1 mb-0" style="font-family:var(--font-display); font-size:1.05rem; color:var(--paper)">@Localizer["HeroTitleLine1"] <span style="color:var(--accent)">@Localizer["HeroTitleLine2"]</span></p>
                </div>
                <div class="col-lg-3">
                    <div class="footer-heading">@Localizer["FooterPages"]</div>
                    <ul class="footer-list">
                        <li><a asp-page="/Stations">@Localizer["NavStations"]</a></li>
                        <li><a asp-page="/Packages">@Localizer["NavPackages"]</a></li>
                        <li><a asp-page="/About">@Localizer["NavAbout"]</a></li>
                        <li><a asp-page="/Contacts">@Localizer["NavContacts"]</a></li>
                        <li><a asp-page="/FAQ">@Localizer["NavFAQ"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <div class="footer-heading">@Localizer["FooterContact"]</div>
                    <ul class="footer-list">
                        <li>Gustav Adolfs Torg 10, Malmö</li>
                        <li>+46 761 234 578</li>
                        <li>info@washzone.se</li>
                    </ul>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon" aria-label="Instagram">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                        </a>
                        <a href="#" class="social-icon" aria-label="Facebook">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
                        </a>
                        <a href="#" class="social-icon" aria-label="X">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817-5.966 6.817h-3.31l7.73-8.835-8.157-10.665h6.828l4.713 6.231 5.414-6.231zm-1.161 17.52h1.833l-11.83-15.644h-1.967l11.964 15.644z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="toast toast-success" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
                    <div class="d-flex align-items-center">
                        <div class="toast-body fw-bold">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="toast toast-danger" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
                    <div class="d-flex align-items-center">
                        <div class="toast-body fw-bold">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            }
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
