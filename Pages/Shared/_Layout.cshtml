@inject IStringLocalizer<SharedResource> Localizer
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WashZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" href="https://img.icons8.com/?size=100&id=2nqOdSG5BPti&format=png&color=000000">
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <span class="brand-mark">WZ</span>
                    <span class="brand">WashZone</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 nav-links">
                        <li class="nav-item"><a class="nav-link" asp-page="/Stations">@Localizer["NavStations"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Packages">@Localizer["NavPackages"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contacts">@Localizer["NavContacts"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/FAQ">@Localizer["NavFAQ"]</a></li>
                    </ul>

                    <div class="nav-links d-flex flex-column flex-lg-row align-items-lg-center gap-1 gap-lg-0 mt-2 mt-lg-0">
                        <partial name="_LoginPartial" />
                        @{
                            var currentLang = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "en";
                            var targetLang = currentLang == "sv" ? "en" : "sv";
                        }
                        <form method="post" action="/set-language" class="ms-lg-3 mt-2 mt-lg-0">
                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                            <input type="hidden" name="culture" value="@targetLang" />
                            <button type="submit" class="lang-btn" title="@(targetLang == "sv" ? "Svenska" : "English")">@currentLang.ToUpperInvariant()</button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-mark">WZ</span>
                        <span class="brand" style="font-size:1.6rem; color:var(--paper)">WashZone</span>
                    </div>
                    <p class="mb-0" style="color:var(--paper); opacity:0.7; max-width:24rem">@Localizer["FooterTagline"]</p>
                </div>
                <div class="col-lg-3">
                    <div class="footer-heading">@Localizer["FooterPages"]</div>
                    <ul class="footer-list">
                        <li><a asp-page="/Stations">@Localizer["NavStations"]</a></li>
                        <li><a asp-page="/Packages">@Localizer["NavPackages"]</a></li>
                        <li><a asp-page="/Contacts">@Localizer["NavContacts"]</a></li>
                        <li><a asp-page="/FAQ">@Localizer["NavFAQ"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <div class="footer-heading">@Localizer["FooterContact"]</div>
                    <ul class="footer-list">
                        <li>Gustav Adolfs Torg 10, Malmö</li>
                        <li>+46 761 234 578</li>
                        <li>info@washzone.se</li>
                    </ul>
                </div>
            </div>
            <div class="border-top mt-5 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span style="font-family:var(--font-mono); font-size:0.8rem">&copy; @DateTime.Now.Year WashZone</span>
                <span class="marker" style="font-size:0.95rem">Clean. Fast. <span style="color:var(--accent)">Flawless.</span></span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
