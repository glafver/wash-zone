@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject IStringLocalizer<SharedResource> Localizer

@if (SignInManager.IsSignedIn(User))
{
    var email = User.Identity?.Name ?? "";
    <div class="dropdown">
        <button class="nav-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            @email
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            @if (User.IsInRole("Admin"))
            {
                <li><a class="dropdown-item" asp-page="/AdminDashboard">@Localizer["NavAdminDashboard"]</a></li>
            }
            else if (User.IsInRole("StationAdmin"))
            {
                <li><a class="dropdown-item" asp-page="/StationDashboard">@Localizer["MyStation"]</a></li>
            }
            else
            {
                <li><a class="dropdown-item" asp-page="/MyBookingsPage">@Localizer["NavMyBookings"]</a></li>
            }
            <li><a class="dropdown-item" asp-page="/Profile">@Localizer["Profile"]</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                    <button type="submit" class="dropdown-item">@Localizer["NavLogout"]</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">@Localizer["NavLogin"]</a>
}
