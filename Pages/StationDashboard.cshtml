@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.StationDashboardModel
@{
    ViewData["Title"] = Localizer["MyStation"].Value;
}

<section class="container py-6">
    <div class="section-sub">WashZone</div>
    <h1 class="section-head mb-4">@Localizer["MyStation"]</h1>

    @if (Model.Station != null)
    {
        <div class="mb-4">
            <h3>@Model.Station.Name</h3>
            <p class="text-muted">@Model.Station.Address</p>
        </div>

        <h4 class="mb-3">@Localizer["Bookings"]</h4>

        @if (Model.Bookings.Any())
        {
            <div class="table-responsive">
                <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["ColDate"]</th>
                        <th>@Localizer["ColTime"]</th>
                        <th>@Localizer["ColUser"]</th>
                        <th>@Localizer["ColPhone"]</th>
                        <th>@Localizer["ColPackage"]</th>
                        <th>@Localizer["ColRegNumber"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td data-label="@Localizer["ColDate"]">@booking.Date.ToString("yyyy-MM-dd")</td>
                            <td data-label="@Localizer["ColTime"]">@booking.Date.ToString("HH:mm")</td>
                            <td data-label="@Localizer["ColUser"]">@booking.User?.UserName</td>
                            <td data-label="@Localizer["ColPhone"]">@booking.User?.PhoneNumber</td>
                            <td data-label="@Localizer["ColPackage"]">@booking.Package?.Name</td>
                            <td data-label="@Localizer["ColRegNumber"]">@booking.RegistrationNumber</td>
                            <td class="actions-cell">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-page="/EditBooking" asp-route-id="@booking.Id" class="btn btn-outline btn-sm">@Localizer["Edit"]</a>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@booking.Id" />
                                        <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">@Localizer["NoBookings"]</p>
        }
    }
</section>
