@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.PackagesModel
@{
    ViewData["Title"] = Localizer["NavPackages"].Value;
}

<section class="container py-6">
    <div class="section-sub">@Localizer["OurPackagesSub"]</div>
    <h1 class="section-head" style="font-size:clamp(2.4rem,6vw,4.5rem)">@Localizer["OurPackages"]</h1>

    <div class="row g-4 mt-2">
        @foreach (var package in Model.Packages)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_PackageCard" model="package" />
            </div>
        }
    </div>
</section>
