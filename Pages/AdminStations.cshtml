@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.AdminStationsModel
@{
    ViewData["Title"] = Localizer["NavStations"].Value;

    var addBtn = new ButtonModel { Text = Localizer["AddStation"].Value, Page = "/StationEdit", Variant = "dark" };
    var backBtn = new ButtonModel { Text = Localizer["Back"].Value, Page = "/AdminDashboard", Variant = "outline" };
}

<section class="container py-6">
    <div class="section-sub">WashZone</div>
    <h1 class="section-head mb-4">@Localizer["ManageStations"]</h1>

    <div class="d-flex gap-2 mb-4">
        <partial name="_Btn" model="addBtn" />
        <partial name="_Btn" model="backBtn" />
    </div>

    <div class="table-responsive">
        <table class="table">
        <thead>
            <tr>
                <th>@Localizer["StationName"]</th>
                <th>@Localizer["StationAddress"]</th>
                <th>@Localizer["StationAdmins"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var station in Model.Stations)
            {
                <tr>
                    <td data-label="@Localizer["StationName"]">@station.Name</td>
                    <td data-label="@Localizer["StationAddress"]">@station.Address</td>
                    <td data-label="@Localizer["StationAdmins"]">@(Model.AdminNames.TryGetValue(station.Id, out var admins) ? admins : "")</td>
                    <td class="actions-cell">
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-page="/StationEdit" asp-route-id="@station.Id" class="btn btn-outline btn-sm">@Localizer["Edit"]</a>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="id" value="@station.Id" />
                                <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">@Localizer["Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>
</section>
