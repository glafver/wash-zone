@page
@inject IStringLocalizer<SharedResource> Localizer
@model WashZone.Pages.EditBookingModel
@{
    ViewData["Title"] = "Edit Booking";
    var currentStation = Model.Stations.FirstOrDefault(s => s.Id == Model.SelectedStationId);
    var stationButtonText = currentStation?.Name ?? Localizer["BookSelectStationFirst"].Value;
}

<section class="container py-6">
<div class="section-sub">WashZone</div>
<h1 class="section-head mb-4">@Localizer["EditTitle"]</h1>

<form method="post" class="booking-form" id="bookingForm">
    <input type="hidden" asp-for="Booking.Id" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <label class="form-label">@Localizer["BookStation"]</label>
    <div class="dropdown custom-select">
        <button type="button" class="custom-select__trigger" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="custom-select__value">@stationButtonText</span>
        </button>
        <ul class="dropdown-menu custom-select__menu">
            @foreach (var station in Model.Stations)
            {
                <li><button type="button" class="custom-select__option" data-value="@station.Id">@station.Name</button></li>
            }
        </ul>
        <input type="hidden" asp-for="SelectedStationId" id="Station" />
    </div>
    <span asp-validation-for="SelectedStationId" class="text-danger"></span>

    <label class="form-label">@Localizer["BookPackage"]</label>
    <div class="dropdown custom-select" id="packageSelect">
        <button type="button" class="custom-select__trigger" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="custom-select__value">@Localizer["BookSelectStationFirst"]</span>
        </button>
        <ul class="dropdown-menu custom-select__menu" id="packageMenu">
            <li><button type="button" class="custom-select__option" data-value="">@Localizer["BookSelectStationFirst"]</button></li>
        </ul>
        <input type="hidden" asp-for="SelectedPackageId" id="package" />
    </div>
    <span asp-validation-for="SelectedPackageId" class="text-danger"></span>

    <input type="hidden" name="SelectedSlot" id="selectedSlot" asp-for="SelectedSlot" />

    <label class="form-label">@Localizer["BookChooseSlot"]</label>
    <div id="calendar" class="calendar-container">
        <p class="text-muted">@Localizer["CalendarPrompt"]</p>
    </div>
    <span asp-validation-for="SelectedSlot" class="text-danger"></span>

    <label class="form-label" for="regNumber">@Localizer["BookRegNumber"]</label>
    <input class="form-control" type="text" id="regNumber" name="RegistrationNumber"
           asp-for="RegistrationNumber" placeholder="@Localizer["BookRegPlaceholder"]" required />
    <span asp-validation-for="RegistrationNumber" class="text-danger"></span>

    <div class="d-flex gap-2 mt-4 justify-content-center">
        <button type="submit" class="btn btn-dark">@Localizer["EditSubmit"]</button>
        <a asp-page="@(User.IsInRole("Admin") ? "/AdminDashboard" : "/MyBookingsPage")" class="btn btn-outline d-inline-block">@Localizer["EditCancel"]</a>
    </div>
</form>
</section>

<script>
    const bookingId = @Model.Booking.Id;
    let selectedSlot = '@Model.SelectedSlot';

    function parseSlot(s) {
        const parts = s.split('T');
        const d = parts[0].split('-').map(Number);
        const t = parts[1].split(':').map(Number);
        return new Date(d[0], d[1] - 1, d[2], t[0], t[1], t[2]);
    }
    function toHHMM(minutes) {
        const h = String(Math.floor(minutes / 60)).padStart(2, '0');
        const m = String(minutes % 60).padStart(2, '0');
        return h + ':' + m;
    }
    function toMinutes(hhmm) {
        const p = hhmm.split(':').map(Number);
        return p[0] * 60 + p[1];
    }

    function renderCalendar(data) {
        const calendar = document.getElementById('calendar');
        const step = 30;
        const opening = toMinutes(data.openingTime);
        const closing = toMinutes(data.closingTime);
        const duration = data.durationMinutes;
        const now = new Date();
        const booked = data.booked.map(b => ({ start: parseSlot(b.start), duration: b.duration }));

        function isBooked(start) {
            const end = new Date(start.getTime() + duration * 60000);
            return booked.some(b => {
                const bEnd = new Date(b.start.getTime() + b.duration * 60000);
                return start < bEnd && b.start < end;
            });
        }

        let html = '<div class="calendar-grid">';
        html += '<div class="cal-header"></div>';
        for (const day of data.days) {
            html += `<div class="cal-header">${day.weekday}<br>${day.day} ${day.month}</div>`;
        }
        for (let t = opening; t + duration <= closing; t += step) {
            const timeLabel = toHHMM(t);
            html += `<div class="cal-time">${timeLabel}</div>`;
            for (const day of data.days) {
                const slotStr = `${day.date}T${timeLabel}:00`;
                const start = parseSlot(slotStr);
                const past = start < now;
                const bookedCell = isBooked(start);
                const isSelected = selectedSlot === slotStr;
                let cls;
                if (bookedCell || past) cls = 'cal-cell booked';
                else if (isSelected) cls = 'cal-cell selected';
                else cls = 'cal-cell available';
                html += `<div class="${cls}" data-slot="${slotStr}"></div>`;
            }
        }
        html += '</div>';
        calendar.innerHTML = html;

        calendar.querySelectorAll('.cal-cell.available').forEach(cell => {
            cell.addEventListener('click', () => {
                selectedSlot = cell.getAttribute('data-slot');
                document.getElementById('selectedSlot').value = selectedSlot;
                calendar.querySelectorAll('.cal-cell').forEach(c => c.classList.remove('selected'));
                cell.classList.add('selected');
            });
        });
    }

    function renderEmpty() {
        document.getElementById('calendar').innerHTML = '<p class="text-muted">@Localizer["CalendarPrompt"]</p>';
    }

    function loadPackages(initial) {
        const stationId = document.getElementById('Station').value;
        const packageMenu = document.getElementById('packageMenu');
        const packageValue = document.querySelector('#packageSelect .custom-select__value');

        document.getElementById('package').value = '';
        packageValue.textContent = '@Localizer["BookSelectStationFirst"]';
        packageMenu.innerHTML = '<li><button type="button" class="custom-select__option" data-value="">@Localizer["BookSelectStationFirst"]</button></li>';

        if (!stationId) { renderEmpty(); return; }
        fetch(`/EditBooking?handler=Packages&stationId=${stationId}`)
            .then(r => r.json())
            .then(data => {
                packageMenu.innerHTML = '';
                data.forEach(p => {
                    const li = document.createElement('li');
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'custom-select__option';
                    b.setAttribute('data-value', p.id);
                    b.textContent = `${p.name} (${p.durationMinutes} min, ${p.price} kr)`;
                    li.appendChild(b);
                    packageMenu.appendChild(li);
                });
                if (initial) {
                    const currentId = '@Model.SelectedPackageId';
                    const currentItem = packageMenu.querySelector('button[data-value="' + currentId + '"]');
                    if (currentItem) {
                        document.getElementById('package').value = currentId;
                        packageValue.textContent = currentItem.textContent.trim();
                        currentItem.classList.add('is-selected');
                        fetchCalendar();
                    } else {
                        renderEmpty();
                    }
                } else {
                    renderEmpty();
                }
            })
            .catch(() => {});
    }

    function fetchCalendar() {
        const stationId = document.getElementById('Station').value;
        const packageId = document.getElementById('package').value;
        document.getElementById('selectedSlot').value = selectedSlot;
        if (!stationId || !packageId) { renderEmpty(); return; }
        fetch(`/EditBooking?handler=Calendar&stationId=${stationId}&packageId=${packageId}&bookingId=${bookingId}`)
            .then(r => r.json())
            .then(renderCalendar)
            .catch(() => {});
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('Station').addEventListener('change', () => loadPackages(false));
        document.getElementById('package').addEventListener('change', fetchCalendar);
        if (document.getElementById('Station').value) {
            loadPackages(true);
        }
    });
</script>
