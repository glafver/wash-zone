# Copy this file to `.env` and fill in real values.
# The `.env` file is git-ignored and never committed.

# Password for the SQL Server `sa` user (must meet SQL Server complexity requirements).
MSSQL_SA_PASSWORD=YourStrong!Pass123

# Google Maps JavaScript API key. Leave empty if you don't need the map on the home page.
GOOGLE_MAPS_API_KEY=
