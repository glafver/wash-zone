# Copy this file to `.env` and fill in real values.
# The `.env` file is git-ignored and never committed.

# Supabase PostgreSQL connection string (Npgsql key=value format).
# Get the values from: Supabase dashboard → Project Settings → Database.
#
# Use the SESSION POOLER host (aws-0-<region>.pooler.supabase.com, port 5432):
#   - IPv4 (works from Google Cloud / most networks; the direct connection
#     db.<ref>.supabase.co:5432 is IPv6-only on the free tier)
#   - supports EF Core migrations (the "Transaction pooler" on port 6543 does not)
#
# NOTE: Npgsql uses key=value pairs (NOT the postgresql:// URI format).
ConnectionStrings__DefaultConnection=Host=aws-0-YOUR-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR-PROJECT-REF;Password=YOUR-DB-PASSWORD;SSL Mode=Require
