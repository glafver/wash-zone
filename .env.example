# Copy this file to `.env` and fill in real values.
# The `.env` file is git-ignored and never committed.

# Supabase PostgreSQL connection string.
# Get it from: Supabase dashboard → Project Settings → Database → Connection string.
#
# Use the SESSION POOLER connection (host *.pooler.supabase.com, port 5432):
#   - IPv4 (works from Google Cloud and most networks; the direct connection
#     db.<ref>.supabase.co:5432 is IPv6-only on the free tier)
#   - supports EF Core migrations (the "Transaction pooler" on port 6543 does not)
ConnectionStrings__DefaultConnection=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
